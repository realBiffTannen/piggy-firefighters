  "skin_slots": {
    "method": "Cut one full-figure skin into the template's slots on the same canvas.\n\n    The drawing is split into CELLS (flat-colour regions bounded by ink). A cell goes whole to one slot when\n    >= `cell_major` of it lies in that template slot (the template label map: front-most template mask, else the\n    nearest); a cell straddling two slots is split pixel-wise on the template boundary. An override polygon\n    (derive.layout.json) claims every cell whose majority lies inside it: this keeps each skin's extras on the right\n    slot (grandma's cat and dress, dad's robe skirt and the piggyback twin stay on the body; the lower twin's head\n    is the head). Ink goes to the front-most slot among the cells within `ink_px` (the front part owns a shared\n    outline), else the nearest. Legs get the same hidden top extension as the template legs.",
    "params": {
      "ink_lum": 75,
      "cell_major": 0.8,
      "ink_px": 14,
      "leg_extend_px": 140,
      "why": "cells (flat colour regions between ink lines) follow the template slot that holds >= 80 % of them; straddling cells split on the template boundary; overrides keep each skin's extras on the right slot (reviewed on qa/art/parts/pf_rescued_skin_slots_r2.png)"
    },
    "slot_names": [
      "head",
      "body_no_head_no_arms",
      "arm_right",
