 "coordinates": "sheet pixels, x right / y down, [start, end)",
 "rules": {
  "eyes": "keep BOTH eyes: the two largest components that are not brows; a brow is a solid dark stroke (>= 85 % dark ink, < 2 % white) with another component below it overlapping >= 30 % of the narrower width. Brows are dropped here (brow pieces come only from the brow row).",
  "brows": "keep the two largest components (the brow pair)",
  "mouth": "keep the mouth only: the largest component; any other stroke in the cell is dropped and listed under `dropped` in registration.json",
  "single": "keep the single largest component",
  "hand": "keep the whole hand: every component in the cell",
  "plate": "keep the plate: the largest component plus any component inside its box",
  "whole": "keep every component in the cell",
  "figure": "keep the largest component whose centroid lies in the cell; the figure may overhang the cell rectangle (the three poses interlock in x), and it is cut by its own component mask so no neighbour pixel is taken"
 },
