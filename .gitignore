.env

# turbo
.turbo

#svelte-kit
.svelte-kit
# Only the ROOT build output. The upstream template ignored every directory named `build`,
# which silently dropped apps/piggy_firefighters/src/components/build, src/game/build and
# static/assets/build (the whole bonus scene) from the first push — found 2026-09-19.
/build
packages/*/build/
out/
dist
# ...except the committed upload copy (game/BUILD_INFO.md describes it). Found un-tracked 2026-09-19.
!game/dist/

#storybook
build-storybook.log
storybook-static

#audiosprite raw resource
apps/**/src/game/resources/
apps/**/src/game/sounds/

#vercel
.vercel

#playwright
test-results
apps/**/test-videos/
apps/**/test-report
apps/**/test-results
apps/**/test-result

#allure report
apps/**/allure-report
apps/**/allure-results


packages/e2e/math-testing/*/*.json
packages/e2e/math-testing/*/*.png
packages/e2e/math-testing/*/*.txt
packages/e2e/math-testing/__pycache__/*
# ---- Piggy Workers: generated / oversized artefacts (regenerable; GitHub refuses files > 100 MB) ----
# math: the book files are 200-470 MB each. LUTs, index.json and MANIFEST.json stay in; the books are
# regenerated by the pipeline (math/games/piggy_firefighters/run.py) or copied from the upload set.
math/publish/books_*.jsonl.zst
math/archive/
math/games/*/library/
math/env/
qa/dev_books_v23/
# staged production build (game/dist is the committed upload copy)
apps/piggy_firefighters/build/
# lossless audio draws and encoded runtime copies (masters are the source of truth and stay in)
audio/cues_pcm/
audio/runtime/
# QA captures and recordings (reports, logs, CSV and JSON stay in)
qa/**/*.png
qa/**/*.jpg
qa/**/*.webm
qa/**/*.mp4
.rigs_route_hold/

# rig pipeline outputs (regenerated from the .spine / part PNGs beside them) and python caches
art-src/animation/rigs/*/build/
__pycache__/

# push log written by the coordinator
qa/git_push.log

# rollback copy of the pre-recommission audio (2026-09-19), never committed
audio/archive_pre_recommission_0919/


# ---- Piggy Firefighters: dev math outputs (Claude's 10k runs), python build artefacts, scratch
qa/dev_math/**/*.jsonl*
math/games/*/library/
*.egg-info/
math/env/
__pycache__/
